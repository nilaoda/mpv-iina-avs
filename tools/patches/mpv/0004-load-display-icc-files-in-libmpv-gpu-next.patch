+// Keep file and Render API profiles separate so clearing a file can restore
+// the latest display profile. An explicit file always overrides profile-auto.
+static pl_icc_object *get_active_icc_profile(struct pl_video *p)
+{
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    const struct mp_icc_opts *icc = opts->icc_opts;
+    if (!icc)
+        return NULL;
+    if (icc->profile && icc->profile[0])
+        return &p->icc_profile_file;
+    return icc->profile_auto ? &p->icc_profile : NULL;
+}
+
+static void update_icc_options(struct pl_video *p, const struct mp_icc_opts *opts)
+{
+    if (!opts)
+        return;
+
+    int r = 0, g = 0, b = 0;
+    gl_parse_3dlut_size(opts->size_str, &r, &g, &b);
+    p->icc_params.intent = opts->intent;
+    p->icc_params.size_r = r;
+    p->icc_params.size_g = g;
+    p->icc_params.size_b = b;
+
+    const char *path = opts->profile && opts->profile[0] ? opts->profile : NULL;
+    if (!path) {
+        pl_icc_close(&p->icc_profile_file);
+        TA_FREEP(&p->icc_profile_path);
+        return;
+    }
+    if (p->icc_profile_path && !strcmp(path, p->icc_profile_path))
+        return;
+
+    // A missing or invalid replacement must not retain the previous display's
+    // profile or silently fall back to the auto profile behind an explicit file.
+    pl_icc_close(&p->icc_profile_file);
+    talloc_replace(p, p->icc_profile_path, path);
+    char *filename = mp_get_user_path(NULL, p->global, path);
+    mp_msg(p->log, MSGL_V, "gpu-next: opening ICC profile '%s'\n", filename);
+    bstr data = stream_read_file(filename, p, p->global, 100000000);
+    struct pl_icc_profile profile = { .data = data.start, .len = data.len };
+    pl_icc_profile_compute_signature(&profile);
+    if (!data.len || !pl_icc_update(p->pllog, &p->icc_profile_file,
+                                  &profile, &p->icc_params)) {
+        pl_icc_close(&p->icc_profile_file);
+        mp_msg(p->log, MSGL_ERR, "gpu-next: failed to load ICC profile '%s'\n",
+               filename);
+    }
+    talloc_free(data.start);
+    talloc_free(filename);
+}
