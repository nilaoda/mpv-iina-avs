@@ -454,15 +459,66 @@ static void handle_audio_frame(struct mp_filter *f)

     MP_VERBOSE(p, "inserting resampler\n");

-    struct mp_swresample *s = mp_swresample_create(f, NULL);
+    struct mp_resample_opts *opts =
+        mp_get_config_group(NULL, f->global, &resample_conf);
+    bool limit_downmix = opts->limit_downmix && !opts->normalize &&
+                        af_fmt_is_pcm(afmt) && af_fmt_is_pcm(out_afmt) &&
+                        chmap.num > 2 && out_chmap.num <= 2 &&
+                        !mp_chmap_is_unknown(&chmap) &&
+                        !mp_chmap_is_unknown(&out_chmap);
+    struct mp_filter *chain = limit_downmix ?
+        mp_bidir_dummy_filter_create(f) : NULL;
+    if (limit_downmix && !chain)
+        abort();
+    struct mp_swresample *s = mp_swresample_create(chain ? chain : f, NULL);
     if (!s)
         abort();

-    s->out_format = out_afmt;
+    // Preserve peaks in floating point until after downmix and limiting.
+    s->out_format = limit_downmix ? AF_FORMAT_DOUBLE : out_afmt;
     s->out_rate = out_srate;
     s->out_channels = out_chmap;
+    p->audio_resampler = s->f;
+
+    if (limit_downmix) {
+        struct mp_lavfi *limiter = mp_lavfi_create_graph(chain, MP_FRAME_AUDIO,
+            true, NULL, NULL,
+            "[in]alimiter=limit=0.95:level=false:latency=true[out]");
+        struct mp_resample_opts convert_opts = MP_RESAMPLE_OPTS_DEF;
+        // Apply explicit dithering only at the final sample-format conversion.
+        int num_dither_opts = 0;
+        for (int n = 0; opts->avopts && opts->avopts[n]; n += 2) {
+            const char *key = opts->avopts[n];
+            if (strcmp(key, "dither_method") && strcmp(key, "dither_scale") &&
+                strcmp(key, "output_sample_bits"))
+                continue;
+            MP_TARRAY_APPEND(chain, convert_opts.avopts, num_dither_opts,
+                             opts->avopts[n]);
+            MP_TARRAY_APPEND(chain, convert_opts.avopts, num_dither_opts,
+                             opts->avopts[n + 1]);
+        }
+        if (num_dither_opts)
+            MP_TARRAY_APPEND(chain, convert_opts.avopts, num_dither_opts, NULL);
+        struct mp_swresample *convert = mp_swresample_create(chain, &convert_opts);
+        if (!limiter || !convert) {
+            talloc_free(chain);
+            talloc_free(opts);
+            p->audio_resampler = NULL;
+            MP_ERR(p, "Cannot initialize downmix limiter.\n");
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+        convert->out_format = out_afmt;
+        convert->out_rate = out_srate;
+        convert->out_channels = out_chmap;
+        struct mp_filter *filters[] = {s->f, limiter->f, convert->f};
+        mp_chain_filters(chain->ppins[0], chain->ppins[1], filters, 3);
+        MP_VERBOSE(p, "Limiting downmix peaks from %d to %d channels\n",
+                   chmap.num, out_chmap.num);
