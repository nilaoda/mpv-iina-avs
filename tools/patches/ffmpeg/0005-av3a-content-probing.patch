+ */
+
+#ifndef AVCODEC_AV3A_PARSE_H
+#define AVCODEC_AV3A_PARSE_H
+
+#include <stdint.h>
+
+#define AV3A_HEADER_SIZE 9
+#define AV3A_FRAME_SAMPLES 1024
+#define AV3A_MAX_FRAME_SIZE 65536
+
+typedef struct AV3AHeader {
+    int sample_rate;
+    int channels;
+    int bit_rate;
+    int bits_per_sample;
+    int frame_size;
+    int profile;
+    int nn_type;
+} AV3AHeader;
+
+/* 只读取实际存在的头部字节，不要求输入带额外填充，也不分配内存。 */
+int avpriv_av3a_parse_header(const uint8_t *buf, int size, AV3AHeader *hdr);
+
+#endif
