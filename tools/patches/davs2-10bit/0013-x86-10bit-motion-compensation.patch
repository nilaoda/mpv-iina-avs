+    __m256i hi = _mm256_setzero_si256();
+    int k;
+
+    for (k = 0; k < 4; k++) {
+        __m256i a = _mm256_loadu_si256((const __m256i *)(src + x - 3 + 2 * k));
+        __m256i b = _mm256_loadu_si256((const __m256i *)(src + x - 2 + 2 * k));
+        __m256i c = coeff_pair_256(coeff, k);
