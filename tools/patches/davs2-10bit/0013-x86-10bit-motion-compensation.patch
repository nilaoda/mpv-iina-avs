+            out = _mm_packus_epi32(lo, hi);
+            _mm_storeu_si128((__m128i *)(dst + x), out);
+            x += 8;
+        }
+        for (; x < width; x++) {
+            int v = 0;
+            int k;
+            for (k = 0; k < 4; k++) {
+                v += win[k * i_src + x] * coeff[k];
+            }
+            v = (v + offset) >> shift;
+            dst[x] = (pel_t)(v > max_value ? max_value : (v < 0 ? 0 : v));
+        }
+        dst += i_dst;
+    }
+}
+
+void intpl_luma_block_hor_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                               int width, int height, const int8_t *coeff)
+{
+    hor_8tap_pel(dst, i_dst, src, i_src, width, height, coeff, 32, 6, max_pel_value);
+}
+
+void intpl_luma_block_ver_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                               int width, int height, const int8_t *coeff)
+{
+    ver_8tap_pel(dst, i_dst, (const int16_t *)src, i_src, width, height,
+                 coeff, 32, 6, max_pel_value);
+}
+
+void intpl_luma_block_ext_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                               int width, int height, const int8_t *coeff_h,
+                               const int8_t *coeff_v)
+{
+    enum { TMP_STRIDE = 64 };
+    const int shift1 = g_bit_depth - 8;
+    const int add1 = (1 << shift1) >> 1;
+    const int shift2 = 20 - g_bit_depth;
+    const int add2 = 1 << (shift2 - 1);
+    ALIGN32(int16_t tmp[(64 + 7) * TMP_STRIDE]);
+
+    hor_8tap_i16(tmp, TMP_STRIDE, src - 3 * i_src, i_src, width, height + 7,
+                 coeff_h, add1, shift1);
+    ver_8tap_pel(dst, i_dst, tmp + 3 * TMP_STRIDE, TMP_STRIDE, width, height,
+                 coeff_v, add2, shift2, max_pel_value);
+}
+
+void intpl_chroma_block_hor_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                                 int width, int height, const int8_t *coeff)
+{
+    hor_4tap_pel(dst, i_dst, src, i_src, width, height, coeff, 32, 6, max_pel_value);
+}
+
+void intpl_chroma_block_ver_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                                 int width, int height, const int8_t *coeff)
+{
+    ver_4tap_pel(dst, i_dst, (const int16_t *)src, i_src, width, height,
+                 coeff, 32, 6, max_pel_value);
+}
+
+void intpl_chroma_block_ext_avx2(pel_t *dst, int i_dst, pel_t *src, int i_src,
+                                 int width, int height, const int8_t *coeff_h,
+                                 const int8_t *coeff_v)
+{
+    enum { TMP_STRIDE = 32 };
+    const int shift1 = g_bit_depth - 8;
+    const int add1 = (1 << shift1) >> 1;
+    const int shift2 = 20 - g_bit_depth;
+    const int add2 = 1 << (shift2 - 1);
+    ALIGN32(int16_t tmp[(32 + 3) * TMP_STRIDE]);
+
+    hor_4tap_i16(tmp, TMP_STRIDE, src - i_src, i_src, width, height + 3,
+                 coeff_h, add1, shift1);
+    ver_4tap_pel(dst, i_dst, tmp + TMP_STRIDE, TMP_STRIDE, width, height,
+                 coeff_v, add2, shift2, max_pel_value);
+}
