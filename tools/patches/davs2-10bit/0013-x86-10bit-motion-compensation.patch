+static inline __m256i coeff_pair_256(const int8_t *coeff, int pair)
+{
+    return _mm256_set1_epi32(((int)coeff[2 * pair + 1] * 65536) +
+                             ((int)coeff[2 * pair] & 0xffff));
+}
