+            hi = finish_pel_128(hi, offset128, shift128, max128);
+            out = _mm_packus_epi32(lo, hi);
+            _mm_storeu_si128((__m128i *)(dst + x), out);
+            x += 8;
+        }
+        for (; x < width; x++) {
+            int v = 0;
+            int k;
+            for (k = 0; k < 8; k++) {
+                v += src[x - 3 + k] * coeff[k];
+            }
+            v = (v + offset) >> shift;
+            dst[x] = (pel_t)(v > max_value ? max_value : (v < 0 ? 0 : v));
+        }
+        src += i_src;
+        dst += i_dst;
+    }
