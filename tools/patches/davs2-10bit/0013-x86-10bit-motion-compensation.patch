+static void hor_8tap_pel(pel_t *dst, int i_dst, const pel_t *src, int i_src,
+                         int width, int height, const int8_t *coeff,
+                         int offset, int shift, int max_value)
+{
+    const __m256i offset256 = _mm256_set1_epi32(offset);
+    const __m256i shift256 = _mm256_set1_epi32(shift);
+    const __m256i max256 = _mm256_set1_epi32(max_value);
+    const __m128i offset128 = _mm_set1_epi32(offset);
+    const __m128i shift128 = _mm_set1_epi32(shift);
+    const __m128i max128 = _mm_set1_epi32(max_value);
+    int y, x;
+
+    for (y = 0; y < height; y++) {
+        for (x = 0; x + 16 <= width; x += 16) {
+            __m256i lo, hi, out;
+            hor_8tap_16(src, x, coeff, &lo, &hi);
+            lo = finish_pel_256(lo, offset256, shift256, max256);
+            hi = finish_pel_256(hi, offset256, shift256, max256);
+            out = _mm256_packus_epi32(lo, hi);
+            _mm256_storeu_si256((__m256i *)(dst + x), out);
+        }
+        if (x + 8 <= width) {
+            __m128i lo, hi, out;
